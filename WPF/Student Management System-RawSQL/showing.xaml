<Page x:Class="Project_Siana.showing"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Project_Siana"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Background="GhostWhite"
      Title="showing">
    <Grid>
        <Grid.RowDefinitions>
             <RowDefinition Height="*"/>
             <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Content="Management" FontSize="23" FontWeight="Bold" Margin="0,0,0,62" />
        <Label Grid.Row="0" Content="System" FontSize="23" FontWeight="Bold" VerticalAlignment="Top" Margin="0,32,38,0" />
        <Label Grid.Row="0" Content="STUDENT RECORDS" FontSize="15" FontWeight="Bold" VerticalAlignment="Top" Margin="0,63,38,0" Foreground="DarkBlue"/>
        <!-- Back Button-->
        <Button Grid.Row="0" Content="Back" Height="30" Width="60" HorizontalAlignment="Right" Margin="0,0,20,50" Click="back_button"/>
        <!-- DATA GRID-->
        <DataGrid AutoGenerateColumns="False" Grid.Row="1" Margin="30,0,30,30" FontSize="10" RowHeight="30" IsReadOnly="True" CanUserAddRows="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Name="records_grid">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Header="ID" Width="50"
                    Binding="{Binding id}" />
                <DataGridTextColumn
                    Header="NAME" Width="140"
                    Binding="{Binding name}" />
                <DataGridTextColumn
                    Header="MARKS" Width="45"
                    Binding="{Binding marks}" />
                <DataGridTextColumn
                    Header="COURSE" Width="80"
                    Binding="{Binding course}" />
                <DataGridTextColumn
                    Header="DEPT" Width="50"
                    Binding="{Binding dept}" />
                <DataGridTextColumn
                    Header="CAMPUS" Width="100"
                    Binding="{Binding campus}" />
                <DataGridTextColumn
                    Header="ADDRESS"
                    Binding="{Binding address}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
