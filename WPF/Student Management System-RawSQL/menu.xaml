<Page x:Class="Project_Siana.menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" 
        Background="#9CB080" >
    <!-- ============================================================================================= -->
    <!-- ============================================================================================= -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- ==================== -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.25*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Row="1" Grid.Column="1" Background="#618764" BorderBrush="Black" BorderThickness="0,6,0,0">
                <Label Grid.Row="1" Grid.Column="1" Content="Student Management" HorizontalAlignment="Center" FontSize="35" Foreground="Black" FontWeight="Bold" Margin="0,0,0,0" />
            </Border>
            <Border Grid.Row="2" Grid.Column="1" Background="#618764" BorderBrush="Black" BorderThickness="0,0,0,6">
                <Label Grid.Row="2" Grid.Column="1" Content="System" HorizontalAlignment="Center" FontSize="35" Foreground="Black" FontWeight="Bold" Margin="0,0,0,0" />
            </Border>
            <Label Grid.Row="6" Grid.Column="1" Content="Created by: Asad Ali" FontSize="12" HorizontalAlignment="Right" Foreground="Black" FontWeight="Bold" Margin="0,30,3,0" />
            <!-- ========LEFT SIDE THINGS=============-->
            <!-- we're making one border for the whole left side, then when we want to add buttons in it we can use a stackpanel to stack them one over the other-->
            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="7" Background="#2B5748" BorderBrush="Black" BorderThickness="5,5,5,5" Margin="0,-15,0,0">
                <!-- REMEMBER: in this Grid.Row and Grid.Column will not work-->
                <!-- why? they only work if the parent is a grid, here it is border-->
                <!-- so either we use a stackpanel that will stack them one over the other-->
                <!-- or we make grid row/column definitions in it, then we can use Grid.Row/.Column-->
                <!-- so we're making grid inside instead of stackpanel so we can work freely-->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                <Button Grid.Row="1" Content="New" Background="#273338" Margin="20,15" Foreground="White" FontSize="20" FontWeight="DemiBold" BorderBrush="Azure" BorderThickness="4" Click="save_click"/>
                <Button Grid.Row="2" Content="Update" Background="#273338" Margin="20,15" Foreground="White" FontSize="20" FontWeight="DemiBold" BorderBrush="Azure" BorderThickness="4" Click="update_click"/>
                <Button Grid.Row="3" Content="Delete" Background="#273338" Margin="20,15" Foreground="White" FontSize="20" FontWeight="DemiBold" BorderBrush="Azure" BorderThickness="4" Click="delete_click"/>
                <Button Grid.Row="4" Content="Records" Background="#273338" Margin="20,15" Foreground="White" FontSize="20" FontWeight="DemiBold" BorderBrush="Azure" BorderThickness="4" Click="records_click"/>
            </Grid>
            </Border>
        </Grid>
</Page>

