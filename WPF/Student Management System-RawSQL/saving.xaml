<Page x:Class="Project_Siana.saving"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="GhostWhite">
    <DockPanel>
        <TextBlock 
                FontSize="30"
                FontWeight="Bold"
                DockPanel.Dock="Top"
                Text="Management System" 
                Margin="10,5,0,0"
      />
        <TextBlock 
        FontSize="20"
        FontWeight="Bold"
        DockPanel.Dock="Top"
        Text="NEW ENTRY" 
        Margin="10,5,0,0"
         Foreground="DarkBlue"
      />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DockPanel.Dock="Bottom">
            <Button Name="btnsave" FontSize="25" Content="Save" Height="50" Width="100" Margin="10" Padding="5" Click="Button_Click"/>
        </StackPanel>
        <!-- ========================================================================================================-->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- ==================== -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <!-- now making the controls-->
            <!-- row 01 -->
            <Label Grid.Row="0" Grid.Column="1" Content="Name:" FontSize="25" HorizontalAlignment="Left"  Margin="0,0,5,10"/>
            <TextBox Name="namebox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" FontSize="25" Height="40" Background="LightBlue" Margin="85,0,70,20"/>
            <!-- row 2 -->
            <Label Grid.Row="1" Grid.Column="0" Content="Marks:" HorizontalAlignment="Right" FontSize="25" Margin="0,0,4,0"/>
            <TextBox Name="marksbox"  Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" FontSize="21" Height="35" Width="100" Margin="0,10,0,18"/>
            <Label Grid.Row="1" Grid.Column="2" FontSize="25" Content="Course:" HorizontalAlignment="Right" Margin="40,0,0,12"/>
            <ComboBox Name="coursebox" Grid.Row="1" Grid.Column="3" VerticalAlignment="Top" Margin="0,5,200,0" FontSize="20" MaxDropDownHeight="150" >
                <!-- the fontsize used above is the size of thing when it is selected and goes into the main combobox -->
                <ComboBoxItem Content="Discrete" FontSize="20"/>
                <ComboBoxItem Content="Calculus" FontSize="20"/>
                <ComboBoxItem Content="Applied Physics" FontSize="20"/>
                <ComboBoxItem Content="Expository Writing" FontSize="20"/>
                <ComboBoxItem Content="Idealogy and Constitution" FontSize="20"/>
                <ComboBoxItem Content="MVC" FontSize="20"/>
                <ComboBoxItem Content="Digital Logic Design" FontSize="20"/>
                <ComboBoxItem Content="Operating System" FontSize="20"/>
            </ComboBox>
            <!-- row 03-->
            <Label Grid.Row="2" Grid.Column="0" Content="Department: " FontSize="22" HorizontalAlignment="Right" Margin="0,0,0,10"/>
            <ComboBox Name="deptbox" Grid.Row="2" Grid.Column="1" FontSize="22"  HorizontalAlignment="Left" Margin="0,0,0,10" Height="35" Width="100"/>
            <Label Grid.Row="2" Grid.Column="2" Content="Campus:" FontSize="25" HorizontalAlignment="Right" Margin="0,5,5,0"/>
            <ComboBox Name="campusbox" Grid.Row="2" Grid.Column="3" Height="35" Width="200" HorizontalAlignment="Left" FontSize="22" IsEditable="True" KeyUp="campusbox_livefiltering" IsTextSearchEnabled="False" PreviewTextInput="campusbox_inputcheck"/>
            <!-- IsTextSearchEnabled is set true by default in WPF -->
            <!-- row 4 -->
            <Label Grid.Row="3" Grid.Column="0" Content="Address:" FontSize="25" VerticalAlignment="Top" Margin="18,2,1,0" />
            <!-- for two rows of address boxes we use rowspan and column span together-->
            <!-- rowspan only makes the textbox physically taller, to go to the next line when writing we need
                                     something else, we need AcceptsReturn and Textwrapping-->
            <TextBox Name="addbox" Grid.Row="3" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="4" FontSize="35" Margin="0,12,20,15" TextWrapping="Wrap" AcceptsReturn="True"/>
            <!-- now making error-messages rows-->
            <TextBlock Name="err_marks" Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Center" Margin="0,35,0,3" Foreground="Red" FontSize="8"/>
            <TextBlock Name="err_add" Grid.Row="3" Grid.Column="3" Height="14" Width="180" VerticalAlignment="Top" Margin="190,0,0,0" Foreground="Red" FontSize="9"/>
            <TextBlock Name="err_name" Grid.Row="0" Grid.Column="3" Height="15" Width="100" HorizontalAlignment="Left" Margin="230,35,0,3" Foreground="Red" FontSize="9"/>
            <TextBlock Name="err_course" Grid.Row="1" Grid.Column="3" Height="15" Width="70" VerticalAlignment="Center" Margin="0,40,40,5" Foreground="Red" FontSize="8"/>
            <TextBlock Name="err_dept" Grid.Row="2" Grid.Column="1" Height="15" Width="55" VerticalAlignment="Bottom" Margin="15,20,5,0" Foreground="Red" FontSize="8"/>
            <TextBlock Name="err_campus" Grid.Row="2" Grid.Column="3" Height="15" Width="100" VerticalAlignment="Center" Margin="110,20,0,0" Foreground="Red" FontSize="9"/>
        </Grid>
    </DockPanel>

</Page>
