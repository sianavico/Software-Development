<Page x:Class="Project_Siana.deleting"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="deleting" Background="GhostWhite">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1.3*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.7*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <!-- Corner Headings-->
        <Label Grid.Row="0" Grid.Column="0" Content="Management" FontSize="25" FontWeight="Bold"/>
        <Label Grid.Row="0" Grid.Column="0" Content="System" FontSize="25" FontWeight="Bold" Margin="0,30,0,0"/>
        <Label Grid.Row="0" Grid.Column="0" Content="DELETE DATA" FontSize="16" FontWeight="Bold" Foreground="DarkBlue" Margin="0,70,0,0"/>
        <!-- ID SEARCH & DELETE BUTTON-->
        <Label Grid.Row="0" Grid.Column="1" Content="ID: " FontSize="30" HorizontalAlignment="Center" FontWeight="Medium" Margin="0,43,250,0"/>
        <TextBox Grid.Row="0" Grid.Column="1" Width="120" Height="50" Margin="0,0,80,30" Name="idbox" FontSize="35"/>
        <TextBlock Name="err_id" Grid.Row="0" Grid.Column="1" Height="20" Width="85" Margin="0,40,30,0" FontSize="8" Foreground="Red"/>
        <Button Grid.Row="0" Grid.Column="1" Height="40" Width="80" Content="DELETE" FontSize="20" Margin="0,120,90,0" Click="delete_click"/>
        <!-- TextBox-->
        <TextBox Grid.Row="1" Grid.Column="1" Width="300" Height="150" Margin="0,0,80,30" IsReadOnly="True" BorderBrush="Black" BorderThickness="5" Name="detailsbox" FontSize="20"/>
    </Grid>
</Page>
